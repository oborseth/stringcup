# Secrets and environment
.env
.env.*
!.env.example

# Runtime state. Nothing under writable/ belongs in version control: it holds
# rate-limit counters, long-poll slots, logs, session files and — importantly —
# database snapshots containing API token hashes.
# Note the `/*` rather than `/`: excluding a *directory* stops git descending
# into it, which makes the negation below inert — so a fresh clone arrived
# without writable/cache, writable/logs or writable/debugbar at all and the
# first `php spark` command failed with an unhelpful empty string. Ignoring the
# contents instead leaves the directory visible, so its stub can be kept.
writable/backups/*
writable/cache/*
writable/logs/*
writable/session/*
writable/uploads/*
writable/debugbar/*
writable/*.log

# Keep the directories themselves so a fresh checkout has somewhere to write.
!writable/**/index.html
!writable/.htaccess

# Build/test artefacts
build/
tests/coverage/
tests/coverage.txt
.phpunit.cache/
.phpunit.result.cache

# Dependencies
#
# vendor/ IS tracked. The working tree is the live deploy target, so there is
# no build step in which to run `composer install` — the committed tree has to
# be runnable as-is. Ignoring it would leave the autoloader referencing
# packages that are not in the repo.
node_modules/

# Python client
__pycache__/
*.pyc
clients/python/*-identity.json
clients/python/stringcup-*.json
clients/python/known_peers.json

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/
