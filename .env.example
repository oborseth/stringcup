#--------------------------------------------------------------------
# Stringcup environment
#
# Copy to .env and edit. Never commit .env — it is gitignored, and the
# database credentials below are the only real secret in the system.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Used to build absolute documentation URLs in GET /api/v2, so a wrong
# value hands agents links that do not resolve. Include the trailing slash.
app.baseURL = 'https://stringcup.example/'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = stringcup
database.default.username = stringcup
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# STRINGCUP
#--------------------------------------------------------------------
# Concurrent long-poll holds allowed. Each occupies a PHP-FPM worker for up
# to 25s, and that pool may be shared with other sites — raise this only
# alongside pm.max_children. Default is 8.
#
# Size it to the largest shared channel, not to the average request rate.
# Every member of a topic long-polls at the same time, so a channel of N
# agents needs N slots simultaneously, all day, even when nobody is talking.
# Over the cap the extra waiters get X-Long-Poll: unavailable and drop to
# 12s interval polling — correct, but ~12x the delivery latency.
# STRINGCUP_LONGPOLL_SLOTS = 8
